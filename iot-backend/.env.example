PORT=3001
FIREBASE_URL=https://<your-project-id>-default-rtdb.firebaseio.com/
MQTT_BROKER=mqtt://broker.hivemq.com
MQTT_TOPIC=iot/envmonitor/data

# IPFS Configuration (Optional: set IPFS_ENABLED=false to skip)
IPFS_ENABLED=false
IPFS_PROVIDER=pinata
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
IPFS_TIMEOUT_MS=20000

# Ganache (Main-Chain Anchors - Optional)
GANACHE_RPC_URL=http://127.0.0.1:7545
GANACHE_CONTRACT_ADDRESS=

# Polygon / Sidechain Configuration (Optional)
POLYGON_RPC_URL=http://127.0.0.1:8545
POLYGON_PRIVATE_KEY=
ANCHOR_CONTRACT_ADDRESS=

# Default Enrichment Coordinates
DEFAULT_LAT=19.072836
DEFAULT_LNG=72.899803
