MQTT_BROKER=mqtt://broker.hivemq.com
MQTT_TOPIC=iot/envmonitor/data
PORT=3001

# ── Location fallback ────────────────────────────────────────────────────────
# Used when device has no GPS fix and no browser location has been pushed.
# Defaults to KJ Somaiya College of Engineering if unset.
DEFAULT_LAT=19.072836
DEFAULT_LNG=72.899803

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to false to skip IPFS uploads (offline dev / CI)
IPFS_ENABLED=true

# ── IPFS ──────────────────────────────────────────────────────────────────────
# Provider: "pinata" (recommended, no daemon) or "kubo" (local daemon)
IPFS_PROVIDER=pinata

# Pinata Cloud — free tier, sign up at https://app.pinata.cloud
# Go to API Keys → New Key → enable pinFileToIPFS + pinJSONToIPFS → copy JWT
PINATA_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..4FTgqSmktfBVJdsfyYtCrb06PhC2WumxO5z-Cv6i-lE

# Public IPFS gateway for reads (change if you prefer a different CDN)
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
IPFS_TIMEOUT_MS=20000

